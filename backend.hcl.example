# Shape documentation only. The real backend.hcl is generated by `make bootstrap`
# and gitignored because its bucket name embeds the AWS account ID.
#
# `key` is deliberately absent because it is supplied per layer on the command line.
# Do not commit or edit the generated backend.hcl.
bucket       = "tfstate-000000000000-us-east-1"
region       = "us-east-1"
encrypt      = true
use_lockfile = true